{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python trade.py:*)",
      "Bash(python3 trade.py:*)",
      "Bash(.venv/bin/python trade.py:*)",
      "Bash(python check.py:*)",
      "Bash(python3 check.py:*)",
      "Bash(.venv/bin/python check.py:*)",
      "Bash(python -m unittest:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(.venv/bin/python -m unittest:*)",
      "Bash(nohup .venv/bin/python board.py:*)",
      "Bash(nohup .venv/bin/python setup.py:*)",
      "Bash(pgrep:*)",
      "Bash(tail:*)",
      "Bash(git pull:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "WebFetch(domain:news.google.com)",
      "Read(./schedule.txt)",
      "Read(./strategy.py)",
      "Edit(./strategy.py)",
      "Read(./.cache/**)",
      "Write(./.cache/judgment.json)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(env)",
      "Bash(printenv:*)"
    ]
  }
}
